# servers/jerry-llm-server/Dockerfile
FROM node:20-slim AS builder
RUN npm install -g pnpm
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
COPY servers/jerry-llm-server/package.json ./servers/jerry-llm-server/
RUN pnpm install --frozen-lockfile --filter jerry-llm-server
COPY servers/jerry-llm-server/ ./servers/jerry-llm-server/
RUN cd servers/jerry-llm-server && pnpm build

FROM node:20-slim AS runner
RUN npm install -g pnpm
WORKDIR /app

# 安装 Puppeteer 所需系统依赖 + 中文字体（用于 PDF/图表生成）
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto-cjk \
    fonts-noto-cjk-extra \
    libnss3 libnspr4 libatk-bridge2.0-0 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/servers/jerry-llm-server/dist ./dist
COPY --from=builder /app/servers/jerry-llm-server/package.json ./
COPY --from=builder /app/pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile
EXPOSE 3000
CMD ["node", "dist/main.js"]