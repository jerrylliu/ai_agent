# ============================================================================
# 生产环境 .env 模板（服务器专用）
#
# 使用方式（在服务器上）：
#   cp .env.production.example .env
#   vim .env   # 填写所有 <必填> 项
#   chmod 600 .env
#
# 密钥生成命令（二选一按需执行）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
#
# 机密安全：本文件与 .env 均不进 git、不进镜像，只存在于服务器磁盘。
# ============================================================================

# ============================================================================
# 【必填项】以下 8 项必须修改后才能启动
# ============================================================================

# JWT 登录签名密钥（强随机 64 位 hex）
JWT_SECRET=<必填：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# 敏感数据加密主密钥（AES-256-GCM，64 位 hex；必须固定，否则重启后嵌入 Key 密文失效）
ENCRYPTION_KEY=<必填：同上命令重新生成，与 JWT_SECRET 用不同值>

# MySQL root 密码（强密码；注意：首次启动初始化后即固定，之后改这里不会同步改库）
# 部署后应用与 MySQL 之间的连接由 compose 注入同一值，保持一致即可
DB_PASSWORD=<必填：强密码，至少 16 位>

# Redis 密码（强密码；compose 用它以 --requirepass 启动 Redis）
REDIS_PASSWORD=<必填：强密码，与 DB_PASSWORD 用不同值>

# 阿里云 DashScope API Key（LLM 对话 / VLM 图片翻译共用）
# 获取：https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=<必填：sk-开头>

# 对外访问域名（用于生成文件/图片外链；HTTPS 就位后填 https:// 形式）
SERVER_BASE_URL=https://<必填：你的域名>

# CORS 允许来源（逗号分隔）：
# 桌面客户端请求的 origin 为空（后端已放行，无需配置）；
# 若同时提供网页访问或调试，追加对应地址
CORS_ORIGINS=https://<必填：你的域名>

# ============================================================================

# 服务端口（容器内监听端口，nginx 反代目标；无需修改）
PORT=3000

# ----------------------------------------------------------------------------
# 数据库（host/port/user 由 compose 容器网络覆盖为 mysql 容器，此处保持原样即可）
# ----------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_DATABASE=cyberpunk
# 生产强制 false：表结构唯一来源是迁移（migration:run），绝不自动改表
TYPEORM_SYNCHRONIZE=false

# ----------------------------------------------------------------------------
# Redis（compose 已强制 REDIS_ENABLED=true 且 REDIS_HOST=redis，此处保持一致）
# ----------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=jerry:
REDIS_COMMAND_TIMEOUT_MS=300
# 限流：单用户每分钟 AI 对话次数（按需调整）
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_FAIL_OPEN=true

# ----------------------------------------------------------------------------
# ChromaDB（compose 容器网络覆盖为 http://chroma:8000）
# ----------------------------------------------------------------------------
CHROMA_URL=http://chroma:8000

# ----------------------------------------------------------------------------
# 嵌入模型：不走 .env！
# 部署后在前端「设置 → 知识库嵌入」配置云端硅基流动（BAAI/bge-m3），
# 配置持久化在挂载的 runtime-config.json 中，重启不丢。
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 模型服务地址（一般无需修改）
# ----------------------------------------------------------------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
OLLAMA_BASE_URL=http://localhost:11434

# ----------------------------------------------------------------------------
# 可选功能：按需填写，留空则对应功能自动禁用，不影响启动
# ----------------------------------------------------------------------------

# PDF 精准解析（保留图片/表格/公式，每日免费 2000 页）
# 获取：https://mineru.net → API管理 → Token
MINERU_ENABLED=false
MINERU_API_TOKEN=
MINERU_TIMEOUT_MS=120000
MINERU_MODEL_VERSION=vlm

# VLM 图片翻译（多模态入库；Key 复用 DASHSCOPE_API_KEY，此处留空即可）
# 主模型说明：2026-09 实测免费额度仅 qwen3.7-flash 可用；充值后建议换 qwen3.7-plus
VLM_ENABLED=true
VLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=
VLM_PRIMARY_MODEL=qwen3.7-flash
VLM_TIMEOUT_MS=120000
VLM_CONCURRENCY=2
VLM_MAX_CALLS_PER_DOC=50
VLM_DOC_TIMEOUT_TOLERANCE_MS=30000
VLM_FALLBACK_MODEL=
VLM_FALLBACK_API_BASE=
VLM_FALLBACK_API_KEY=

# 联网搜索 / 天气查询（可选）
SEARCH_API_URL=
SEARCH_API_KEY=
QWEATHER_API_KEY=
QWEATHER_API_BASE=https://devapi.qweather.com

# DeepSeek / 智谱模型 Key（可选，不用则留空）
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=

# 火山引擎 ASR 语音识别（可选）
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=
VOLC_ASR_STREAM_CLUSTER=volcengine_streaming_common
VOLC_ASR_FILE_CLUSTER=volcengine_input_common

# 文档生成工具（存储目录挂载持久卷，无需修改）
DOCUMENT_STORAGE_DIR=./tmp/documents
DOCUMENT_TTL_DAYS=7
DOCUMENT_IDLE_DAYS=3
DOCUMENT_CLEANUP_INTERVAL_MIN=60
DOCUMENT_MAX_SIZE_MB=20
DOCUMENT_PDF_FORMAT=A4

# 图片存储（挂载持久卷，无需修改）
IMAGE_STORAGE_DIR=./storage/images
IMAGE_MAX_SIZE_BYTES=10485760

# 图片异步重试
IMAGE_RETRY_INTERVAL_MIN=10
IMAGE_RETRY_MAX_RETRY=3

# OCR 降级（可选；需在容器内安装 tesseract.js 才生效，未安装时自动跳过）
OCR_ENABLED=false
OCR_LANG=chi_sim+eng

# 公式解释（可选）
FORMULA_ENABLED=false
FORMULA_MODEL_ID=ollama:qwen3.5-2b
FORMULA_TIMEOUT_MS=30000
FORMULA_MAX_CALLS_PER_DOC=30

# 扫描件检测
SCANNED_PDF_ENABLED=true
SCANNED_PDF_CHARS_THRESHOLD=50
SCANNED_PDF_RENDER_DPI=150

# 注入扫描门禁（可选，公开服务建议开启）
DOC_SCAN_ENABLED=false
DOC_SCAN_LLM_JUDGE_ENABLED=true
DOC_SCAN_MAX_CHUNKS_PER_DOC=100
DOC_SCAN_SUSPICIOUS_ACTION=review

# 飞书通知集成（可选，不用则全部留空）
NOTIFY_FEISHU_APP_ID=
NOTIFY_FEISHU_APP_SECRET=
NOTIFY_FEISHU_DOMAIN=
NOTIFY_FEISHU_EVENT_MODE=ws
NOTIFY_FEISHU_VERIFICATION_TOKEN=
NOTIFY_FEISHU_HITL_USER=
NOTIFY_FEISHU_KNOWLEDGE_SYNC_USER=
NOTIFY_FEISHU_BOT_OPEN_ID=
NOTIFY_FEISHU_CHAT_USER_ID=default

# 邮件通知（可选）
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_SMTP_FROM=

# 外部业务库查询工具（可选，建议只读账号）
NOTIFY_DB_HOST=
NOTIFY_DB_PORT=3306
NOTIFY_DB_USER=
NOTIFY_DB_PASSWORD=
NOTIFY_DB_DATABASE=
NOTIFY_DB_ALLOWED_TABLES=

# MCP Server 代理（可选）
NOTIFY_MCP_SERVERS=

# 日志
LOG_LEVEL=info
# 监控栈（docker-compose.yml 的 loki/prometheus/grafana）如部署，取消注释：
# LOKI_HOST=http://loki:3100
