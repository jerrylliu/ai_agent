{
  "name": "jerry-llm-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm -d dist/typeorm-data-source.js",
    "migration:generate": "pnpm build && pnpm typeorm migration:generate src/migrations/InitialSchema",
    "migration:run": "pnpm build && pnpm typeorm migration:run",
    "migration:revert": "pnpm build && pnpm typeorm migration:revert",
    "migration:show": "pnpm build && pnpm typeorm migration:show"
  },
  "dependencies": {
    "@langchain/classic": "^1.0.29",
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.1.39",
    "@langchain/langgraph": "^1.4.1",
    "@langchain/ollama": "^1.1.39",
    "@langchain/openai": "^1.4.5",
    "@langchain/textsplitters": "^1.0.1",
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "chromadb": "^3.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "diff": "^7.0.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "highlight.js": "^11.11.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "juice": "^12.1.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "mathjs": "^15.2.0",
    "mineru-open-sdk": "^0.2.5",
    "minisearch": "^7.2.0",
    "mysql2": "^3.21.0",
    "nest-winston": "^1.10.2",
    "node-sql-parser": "^5.4.0",
    "nodemailer": "^8.0.11",
    "pdfjs-dist": "^6.0.227",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "turndown": "^7.2.4",
    "typeorm": "^0.3.28",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/diff": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/highlight.js": "^10.1.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/marked": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "maxWorkers": 2
  }
}