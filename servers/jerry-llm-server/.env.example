# ============================================
# 服务端环境配置文件
# 复制此文件为 .env 并根据实际环境修改
# ============================================

# 服务端口
PORT=3000

# JWT 密钥（生产环境必须修改为强随机字符串）
JWT_SECRET=miaoma-ai-secret-key-2024

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=cyberpunk

# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB 服务地址
CHROMA_URL=http://localhost:8000

# 服务基础 URL（用于生成文件访问地址）
SERVER_BASE_URL=http://localhost:3000

# DeepSeek API
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 智谱 API
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 日志级别
LOG_LEVEL=info

# Loki 日志服务地址（可选）
# LOKI_HOST=http://localhost:3100

# 搜索 API（可选，未配置时联网搜索不可用）
SEARCH_API_URL=
SEARCH_API_KEY=

# 天气 API（可选，未配置时天气查询不可用）
QWEATHER_API_KEY=
QWEATHER_API_BASE=https://devapi.qweather.com

# CORS 允许的来源（逗号分隔，生产环境应限制为实际域名）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:1420
