# ============================================
# 服务端环境配置文件
# 复制此文件为 .env 并根据实际环境修改
# ============================================

# 服务端口
PORT=3000

# JWT 密钥（生产环境必须替换为强随机字符串，禁止使用示例占位值）
JWT_SECRET=change-me-use-strong-random-secret

# 敏感数据加密主密钥（AES-256-GCM，32 字节 hex 编码 = 64 字符）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未配置时自动生成临时密钥（重启后旧密文不可解密，仅适合开发环境）
# ENCRYPTION_KEY=

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=cyberpunk
# TypeORM 自动同步开关：默认 false；仅本地临时开发可改为 true，生产环境必须保持 false
TYPEORM_SYNCHRONIZE=false

# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB 服务地址
CHROMA_URL=http://localhost:8000

# 服务基础 URL（用于生成文件访问地址）
SERVER_BASE_URL=http://localhost:3000

# DeepSeek API
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 智谱 API
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 日志级别
LOG_LEVEL=info

# Loki 日志服务地址（可选）
# LOKI_HOST=http://localhost:3100

# 搜索 API（可选，未配置时联网搜索不可用）
SEARCH_API_URL=
SEARCH_API_KEY=

# 天气 API（可选，未配置时天气查询不可用）
QWEATHER_API_KEY=
QWEATHER_API_BASE=https://devapi.qweather.com

# CORS 允许的来源（逗号分隔，生产环境应限制为实际域名）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:1420

# ============================================
# 外部 API 集成工具（方案 A：send_notification / query_database / mcp_proxy）
# 全部为可选；任一项未配置时，对应工具会被自动跳过注册
# ============================================

# ---- send_notification：飞书通道（与知识库同步用的飞书 App 可分离） ----
NOTIFY_FEISHU_APP_ID=
NOTIFY_FEISHU_APP_SECRET=
# 海外版填 larksuite.com，国内版留空或填 feishu.cn
NOTIFY_FEISHU_DOMAIN=
# 事件订阅模式：ws（长连接，开发期/默认）| http（公网回调，上线后启用）
# ws 模式下无需公网地址，由服务端主动连飞书；http 模式需要在飞书后台配置回调 URL
NOTIFY_FEISHU_EVENT_MODE=ws
# 事件订阅签名校验 Token（仅 http 模式生效，ws 模式无需配置）。留空则跳过签名校验（不安全，仅开发环境使用）
NOTIFY_FEISHU_VERIFICATION_TOKEN=
# 飞书 HITL 审批接收人（open_id 或邮箱）。配置后所有 HITL 确认请求会同步推送飞书卡片，可在飞书点按钮审批。留空 = 仅 Web 端审批
NOTIFY_FEISHU_HITL_USER=
# 知识源同步状态通知接收人（open_id 或邮箱）。配置后定时任务同步成功/失败时会推送飞书。留空 = 不推送
NOTIFY_FEISHU_KNOWLEDGE_SYNC_USER=
# 飞书机器人的 open_id（D1 群聊精确 @ 判定用）
NOTIFY_FEISHU_BOT_OPEN_ID=
# 飞书聊天记录归属的项目用户 ID。未登录 Web 端查看填 default；登录态查看填 users 表里的 id
NOTIFY_FEISHU_CHAT_USER_ID=default

# ---- send_notification：邮件通道（SMTP） ----
# 例：smtp.qq.com / smtp.gmail.com / smtp.exmail.qq.com
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
# 发件人地址，留空则使用 NOTIFY_SMTP_USER
NOTIFY_SMTP_FROM=

# ---- query_database：外部业务库（建议用只读账号） ----
NOTIFY_DB_HOST=
NOTIFY_DB_PORT=3306
NOTIFY_DB_USER=
NOTIFY_DB_PASSWORD=
NOTIFY_DB_DATABASE=
# 表名白名单，逗号分隔；留空 = 允许查询所有表（不推荐）
NOTIFY_DB_ALLOWED_TABLES=

# ---- mcp_proxy：MCP Server 配置 ----
# JSON 数组字符串，每项需包含 name / command / args
# 示例（接入文件系统 MCP Server）：
# NOTIFY_MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
NOTIFY_MCP_SERVERS=

# ============================================
# 文档生成（generate_document 工具：AI 生成 PDF / Word / HTML）
# ============================================

# 生成文档的存储目录（默认 ./tmp/documents，容器部署需挂载持久卷）
DOCUMENT_STORAGE_DIR=./tmp/documents
# 硬过期天数：从生成时间起，超过此天数自动删除（推荐 7 天，对齐"工作周"周期）
DOCUMENT_TTL_DAYS=7
# 闲置天数：超过此天数未访问自动删除（推荐 3 天；每次访问会自动续期）
DOCUMENT_IDLE_DAYS=3
# 后台清理任务间隔（分钟），默认 60
DOCUMENT_CLEANUP_INTERVAL_MIN=60
# 单文档最大尺寸（MB），默认 20
DOCUMENT_MAX_SIZE_MB=20
# 默认 PDF 纸张尺寸：A4 / Letter / Legal
DOCUMENT_PDF_FORMAT=A4


# ========================================================================
# Redis 配置（可选）—— 多级缓存 L2 / 接口限流 / 分布式锁
# ------------------------------------------------------------------------
# 设计原则：所有 Redis 能力都"可降级"，未配置 / 连接失败时自动回退到内存方案，
# 保证桌面端用户无需安装 Redis 也能正常使用核心功能。
# ------------------------------------------------------------------------
# REDIS_ENABLED：总开关。false 或留空 = 完全不连 Redis，全部走内存降级
# 生产开服建议 true；个人开发机可以留空
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 密码（生产环境强制要求 AUTH，否则禁止暴露公网）
REDIS_PASSWORD=
# 数据库编号（0-15），不同业务建议分库隔离
REDIS_DB=0
# Key 前缀，避免多业务共用 Redis 时 Key 冲突
REDIS_KEY_PREFIX=jerry:
# 单次命令超时（毫秒）：Redis 抖动时不能拖垮主流程
REDIS_COMMAND_TIMEOUT_MS=300

# ---- 限流（基于 Redis 滑动窗口）----
# 单用户每分钟最多多少次 AI 对话请求；0 = 不限流
RATE_LIMIT_CHAT_PER_MIN=30
# 限流降级策略：true=Redis 不可用时直接放行，false=拒绝请求
RATE_LIMIT_FAIL_OPEN=true

# ============================================
# 火山引擎 ASR（语音识别）—— 可选
# 未配置时语音识别功能不可用，不影响其他功能
# ============================================

# 应用 ID（在火山引擎语音技术控制台创建应用后获取）
VOLC_ASR_APP_ID=
# 访问令牌（密钥，勿泄露到前端或 Git）
VOLC_ASR_ACCESS_TOKEN=
# 流式识别集群 ID（一般不需要修改）
VOLC_ASR_STREAM_CLUSTER=volcengine_streaming_common
# 录音文件识别集群 ID（一般不需要修改）
VOLC_ASR_FILE_CLUSTER=volcengine_input_common

# ============================================
# MinerU 在线 API（PDF 精准解析）—— 可选
# 未配置时使用本地 pdfjs-dist 解析（不支持图片/代码块/表格/公式识别）
# 配置后可保留 PDF 中的图片、代码块、表格、公式结构
# 注意：采用文件上传方式，无需内网穿透，本地文件直接上传给 MinerU
# ============================================

# 总开关：true=启用 MinerU，false=使用本地 pdfjs-dist
MINERU_ENABLED=false
# API Token（访问 https://mineru.net 注册后在「API管理 → Token」获取）
# 每日免费 2000 页高优先级额度
MINERU_API_TOKEN=
# API 超时（毫秒），大文件解析较慢，默认 120 秒
MINERU_TIMEOUT_MS=120000
# 模型版本：pipeline（默认）/ vlm（推荐，效果更好）/ MinerU-HTML
MINERU_MODEL_VERSION=vlm
